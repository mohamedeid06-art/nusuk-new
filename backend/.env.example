# ==========================================
# إعدادات محرك نسك (Nusuk Dual-Emulator Engine)
# انسخ هذا الملف إلى .env وعدّل القيم حسب جهازك
# ==========================================

# مسار تثبيت LDPlayer 9
LDPLAYER_PATH=C:\LDPlayer\LDPlayer9

# اسم حزمة تطبيق نسك
NUSUK_PACKAGE=com.moh.nusukapp

# المحاكي الأول (الرئيسي - Leader)
EMU1_SERIAL=emulator-5596
EMU1_INDEX=21

# المحاكي الثاني (المرافق - Companion)
EMU2_SERIAL=emulator-5594
EMU2_INDEX=20

# كلمة المرور الافتراضية لحسابات المعتمرين الجدد
NUSUK_DEFAULT_PASSWORD=Msamy2006**

# مهلة انتظار القفل بالثواني (0 = إرجاع busy فوراً عند انشغال المحاكيات)
NUSUK_LOCK_WAIT=0

# عنوان ومنفذ السيرفر المحلي
NUSUK_HOST=127.0.0.1
NUSUK_PORT=8000

# نطاقات CORS المسموح لها بالاتصال (استخدم * أو رابط GitHub Pages)
NUSUK_ALLOWED_ORIGINS=*

# إعدادات توقيع طلبات Nusuk API (اختياري - تُستخدم القيم الافتراضية تلقائياً)
NUSUK_API_VERSION=11
NUSUK_DEVICE_ID=00000000-0000-0000-0000-000000000000
